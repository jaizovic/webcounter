{
  "name": "webcounter-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply webcounter --local",
    "db:migrate:remote": "wrangler d1 migrations apply webcounter --remote",
    "check": "node --check src/index.js"
  },
  "devDependencies": {
    "wrangler": "4.145.0"
  }
}
